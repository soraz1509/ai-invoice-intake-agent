    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst inv = data.output;\nconst steps = data.intermediateSteps || [];\nconst issues = [];\nlet critical = false;\n\n// Grounding check: IDs must literally appear in the invoice text\nconst src = ($('Extract from File').first().json.text || '').replace(/\\s/g, '');\nfor (const f of ['vat_id', 'iban', 'invoice_number']) {\n  if (inv[f] && !src.includes(String(inv[f]).replace(/\\s/g, ''))) {\n    issues.push(`${f} \"${inv[f]}\" not found in invoice text – discarded`);\n    inv[f] = '';\n  }\n}\n// Normalize German dates to ISO; flag anything unrecognized\nconst d = String(inv.invoice_date || '').match(/^(\\d{1,2})\\.(\\d{1,2})\\.(\\d{4})$/);\nif (d) inv.invoice_date = `${d[3]}-${d[2].padStart(2, '0')}-${d[1].padStart(2, '0')}`;\nif (inv.invoice_date && !/^\\d{4}-\\d{2}-\\d{2}$/.test(inv.invoice_date)) issues.push(`Unrecognized date format \"${inv.invoice_date}\"`);\n\nfor (const f of ['vendor_name','invoice_number','invoice_date','vat_id'])\n  if (!inv[f]) issues.push(`Missing ${f}`);\nif (!(inv.net_amount > 0) || !(inv.gross_amount > 0)) issues.push('Missing or invalid amounts');\nif (Math.abs(inv.net_amount + inv.vat_amount - inv.gross_amount) > 0.01) issues.push('Net + VAT ≠ Gross');\nif (![0, 7, 19].includes(inv.vat_rate)) issues.push(`Unusual VAT rate ${inv.vat_rate}%`);\nelse if (Math.abs(Math.round(inv.net_amount * inv.vat_rate) / 100 - inv.vat_amount) > 0.02) issues.push('VAT ≠ net × rate');\nif (!inv.vendor_known) issues.push('Unknown vendor – IBAN not verifiable');\nif (inv.vendor_known && (!inv.iban || !inv.iban_matches_master)) { issues.push('IBAN missing or differs from vendor master – possible fraud'); critical = true; }\nif (inv.duplicate_found) issues.push('Possible duplicate invoice');\n\nconst agent_trace = steps.length\n  ? steps.map((s, i) => {\n      const obs = String(s.observation ?? '').trim();\n      const found = obs && obs !== '\"\"' && obs !== '[]';\n      return `${i + 1}. Agent called ${s.action.tool} with ${JSON.stringify(s.action.toolInput)} → ${found ? 'record found' : 'no match'}`;\n    }).join('\\n')\n  : 'Agent called no tools';\n\nconst status = critical ? 'Critical – payment block' : issues.length ? 'Exception' : 'Ready to post';\nreturn [{ json: { ...inv, status, issues: issues.join('; '), agent_trace: agent_trace + '\\nAgent notes: ' + inv.agent_notes, processed_at: new Date().toISOString() } }];"
      },
